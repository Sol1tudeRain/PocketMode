<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0B0F16"
    android:gravity="center" android:paddingStart="24dp" android:paddingEnd="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/pocket_mode_title" android:textSize="25sp"
        android:textColor="#FFFFFF" android:gravity="center" android:textStyle="bold"/>
    <ImageView android:layout_width="180dp" android:layout_height="330dp"
        android:layout_marginTop="32dp" android:src="@drawable/pocket_phone"
        android:contentDescription="@string/pocket_mode_illustration_description"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:text="@string/pocket_mode_instructions_header"
        android:textColor="#D8E5F5" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="@string/pocket_mode_instruction_step1"
        android:textColor="#C0CBD8" android:textSize="15sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:id="@+id/power_hint" android:layout_marginTop="14dp" android:text="@string/pocket_mode_instruction_step2"
        android:textColor="#C0CBD8" android:textSize="15sp"/>
</LinearLayout>
